# Only these are required. VPS host/user/password are entered by the user in the website.
API_TOKEN=change-me-to-a-long-random-string-40-chars
FRONTEND_ORIGINS=http://localhost:5500,https://your-app.vercel.app
MAX_UPLOAD_MB=25
ENABLE_DOCS=true
